        (nat %purchased_at_level)));
<< ContractAnnot
  { (((buyer, (artist, target)), (_, _, _, _, _, licenses, _)), _) | True } ->
  { (ops, r) | ops = [] &&
      r = (match find_opt_b (buyer, (artist, target)) licenses with
           | Some l -> l
           | None -> (0, (0, 0))) } &
  { _ | False } >>
  code
    {
      CAR;
      {
        UNPAIR;
        UNPAIR 3;
        DIG 3;
        GET 11;
        DUG 3;
        PAIR 3;
        GET;
        IF_NONE
          {
            PUSH nat 0;
            DUP;
            DUP;
            PAIR 3
          }
          {
          }
      };
      NIL operation;
      PAIR
    }
}
